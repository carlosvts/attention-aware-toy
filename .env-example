# Copy this file to .env and fill secrets locally.

# TTS
TTS_PROVIDER=generic
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_INSTRUCTIONS=Speak slowly and calmly, like a grounded Buddhist meditation guide. Use a warm, spacious tone with gentle pacing.

# Ollama LLM/VLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_VISION_MODEL=openbmb/minicpm-v4.6
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_VISION_TIMEOUT_SECONDS=60

# Main app
CAMERA_INDEX=0
ATTENTION_THRESHOLD=0.7
ATTENTION_DURATION_SECONDS=1.0
COOLDOWN_SECONDS=5.0
MIN_DUCKING_SECONDS=1.2
SPEECH_WORDS_PER_SECOND=2.6
SHOW_ATTENTION_WINDOW=true
SHOW_EMOTION_SNAPSHOT_WINDOW=true
SHOW_MUDRA_SNAPSHOT_WINDOW=true

# Profiling
ATTENTION_LOG_DIR=logs
